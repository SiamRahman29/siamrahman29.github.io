---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config';

const skills = {
  Languages: ['Python', 'Go', 'C / C++', 'SQL', 'JavaScript', 'TypeScript', 'Java', 'R'],
  'AI / Infra': [
    'LangChain',
    'CrewAI',
    'LangGraph',
    'RAG',
    'Dramatiq',
    'Kubernetes',
    'AWS',
    'Azure',
    'Docker',
    'LGTM (Loki, Grafana, Tempo, Mimir)',
  ],
  'Web / Data': [
    'FastAPI',
    'Flask',
    'Django',
    'Echo',
    'React',
    'PostgreSQL',
    'Supabase',
  ],
  Spoken: ['English', 'Bengali', 'Spanish'],
};

const achievements = [
  {
    title: 'Silver Medalist, ICPROM',
    org: 'Universiti Teknologi Mara',
    when: 'Oct 2023',
    note: 'Led the university team in the International Competitive Programming and Multimedia Competition.',
  },
  {
    title: '1st Runner-up, Can You Hack It!',
    org: 'Hong Leong Bank',
    when: 'Dec 2023',
    note: 'Designed a Gen AI application helping SMEs with their ESG needs.',
  },
  {
    title: '1st Runner-up, UCSI National Programming Competition',
    org: 'UCSI University',
    when: 'Feb 2023',
  },
];
---

<BaseLayout
  title="About"
  description="Siam Rahman — AI Infrastructure / Backend Engineer. Bio, education, achievements, and skills."
>
  <section class="container-prose pt-12 pb-16 sm:pt-20">
    <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">About</p>
    <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
      A bit more than the homepage fits.
    </h1>

    <div class="prose-custom mt-10">
      <p>
        I'm a full-stack engineer focused on the infrastructure side of AI: RAG
        pipelines, distributed workflows, observability, and the boring,
        important work that turns prototypes into reliable production systems.
      </p>

      <p>
        Most recently, I was at <a href="https://askturing.ai" target="_blank" rel="noopener noreferrer"
          >AskTuring.ai</a
        >, where I led a cross-functional epic on email ingestion and retrieval in a
        production RAG architecture. Before that, I spent six months at <a
          href="https://grab.com"
          target="_blank"
          rel="noopener noreferrer">Grab</a
        > on the AI Infrastructure team, supporting 100+ data scientists.
      </p>

      <p>
        I grew up in Bangladesh, studied in Malaysia, and most recently worked
        remotely for a California-based AI startup. The cross-context view of
        how engineering teams operate, what they prioritize, and what tools
        they actually trust, is a perspective I bring to every system I design.
      </p>

      <p>
        I'm looking for what's next. AI infrastructure, backend, full-stack.
        If you're building something interesting and hiring, I'd love to talk.
      </p>

      <h2>Education</h2>
      <p>
        <strong>Universiti Teknologi Malaysia</strong> · Kuala Lumpur, Malaysia<br />
        Bachelor of Computer Science (Software Engineering) with Honors
      </p>
      <ul>
        <li>CGPA 3.93 · Dean's List in all 8 semesters</li>
        <li>Founded the university Coder's Club and led its competitive programming team to national and international success</li>
        <li>Organized university-wide literary events with the Ink and Literary Society</li>
      </ul>

      <h2>Achievements</h2>
      {
        achievements.map((a) => (
          <p>
            <strong>{a.title}</strong> · {a.org} · {a.when}
            {a.note && (
              <>
                <br />
                <span class="text-[var(--color-text-muted)]">{a.note}</span>
              </>
            )}
          </p>
        ))
      }
    </div>

    <div class="mt-16">
      <h2 class="mb-6 text-lg font-semibold tracking-tight">Skills</h2>
      <dl class="space-y-6">
        {
          Object.entries(skills).map(([group, items]) => (
            <div class="grid gap-2 sm:grid-cols-[140px_1fr] sm:gap-6">
              <dt class="font-mono text-xs uppercase tracking-wider text-[var(--color-text-dim)]">
                {group}
              </dt>
              <dd>
                <ul class="flex flex-wrap gap-1.5">
                  {items.map((item) => (
                    <li class="rounded border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-2 py-0.5 font-mono text-[11px] text-[var(--color-text-muted)]">
                      {item}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-16 border-t border-[var(--color-border)] pt-10">
      <h2 class="mb-4 text-lg font-semibold tracking-tight">Reach me</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href={SITE.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-accent)] hover:underline underline-offset-4"
            >Book a 15-min call ↗</a
          >
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-[var(--color-accent)]"
            >Email</a
          >
        </li>
        <li>
          <a
            href={SITE.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">LinkedIn ↗</a
          >
        </li>
        <li>
          <a
            href={SITE.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">GitHub ↗</a
          >
        </li>
        <li>
          <a
            href={SITE.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">Résumé (PDF) ↗</a
          >
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
