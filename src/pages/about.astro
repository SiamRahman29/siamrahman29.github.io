---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config';

const skills = {
  Languages: ['Python', 'Go', 'C / C++', 'SQL', 'JavaScript', 'TypeScript', 'Java', 'R'],
  'AI / Infra': [
    'LangChain',
    'CrewAI',
    'LangGraph',
    'RAG',
    'Dramatiq',
    'Kubernetes',
    'AWS',
    'Azure',
    'Docker',
    'LGTM (Loki, Grafana, Tempo, Mimir)',
  ],
  'Web / Data': [
    'FastAPI',
    'Flask',
    'Django',
    'Echo',
    'React',
    'PostgreSQL',
    'Supabase',
  ],
  Spoken: ['English', 'Bengali', 'Spanish'],
};

const education = [
  {
    school: 'Universiti Teknologi Malaysia',
    url: 'https://www.utm.my',
    kind: 'BSc',
    degree: 'Computer Science (Software Engineering), Honors',
    where: 'Kuala Lumpur, Malaysia',
    highlight: "CGPA 3.93 · Dean's List, all 8 semesters",
    notes: [
      "Founded the university Coder's Club and led its competitive programming team to national and international wins",
      'Ran university-wide literary events with the Ink and Literary Society',
    ],
  },
  {
    school: 'National University of Singapore',
    url: 'https://www.nus.edu.sg',
    kind: 'Summer',
    degree: 'Summer Science Institute, Physics track',
    where: 'Singapore',
    notes: [
      'Explored NUS research in nanotechnology and quantum computing',
      'Participated in the presentation competition and shared my conept to transform virtual physics education in Bangladesh',
    ],
  },
  {
    school: 'Notre Dame College',
    url: 'https://www.ndc.edu.bd',
    kind: 'HSC',
    degree: 'Higher Secondary School Certificate',
    where: 'Dhaka, Bangladesh',
    highlight: 'GPA 5.00 / 5.00',
    notes: [
      'Won the Honorable Mention Award',
      'Vice-President (Publication), Notre Dame Eco and Space Club',
      'Represented Bangladesh at JENESYS 2018 and MACFAIR International 2018',
    ],
  },
];

const achievements = [
  {
    title: 'Silver Medalist, ICPROM',
    org: 'Universiti Teknologi Mara',
    when: 'Oct 2023',
    note: 'Led the university team in the International Competitive Programming and Multimedia Competition.',
  },
  {
    title: '1st Runner-up, Can You Hack It!',
    org: 'Hong Leong Bank',
    when: 'Dec 2023',
    note: 'Designed a Gen AI application helping SMEs with their ESG needs.',
  },
  {
    title: '1st Runner-up, UCSI National Programming Competition',
    org: 'UCSI University',
    when: 'Feb 2023',
  },
];
---

<BaseLayout
  title="About"
  description="Siam Rahman — AI Infrastructure / Backend Engineer. Bio, education, achievements, and skills."
>
  <section class="container-prose pt-12 pb-16 sm:pt-20">
    <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">About</p>
    <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
      A bit more than the homepage fits.
    </h1>

    <div class="prose-custom mt-10">
      <p>
        I'm a full-stack engineer working the infrastructure side of AI: RAG
        pipelines, distributed workflows, observability, and the unglamorous
        work that turns prototypes into systems you can trust in production.
      </p>

      <p>
        Most recently I led an email ingestion and retrieval epic in a
        production RAG stack at <a href="https://askturing.ai" target="_blank"
          rel="noopener noreferrer">AskTuring.ai</a
        >. Before that, six months on <a href="https://grab.com" target="_blank"
          rel="noopener noreferrer">Grab</a
        >'s AI Infrastructure team, supporting 100+ data scientists.
      </p>

      <p>
        I grew up in Bangladesh, studied in Malaysia, and shipped production
        systems remotely for a California startup across a half-day timezone
        gap. That taught me to own work without anyone watching: write things
        down, lean on observability, stay reachable through the hours that
        overlap. Remote isn't something I need accommodated. It's how I already
        work.
      </p>

      <p>
        I'm looking for what's next: AI infrastructure, backend, or full-stack,
        remote-first with relocation on the table for the right team. If you're
        building something interesting, let's talk.
      </p>
    </div>

    <div class="mt-16">
      <h2 class="mb-6 text-lg font-semibold tracking-tight">Education</h2>
      <div class="space-y-8">
        {
          education.map((e) => (
            <div class="border-l border-[var(--color-border)] pl-5 sm:pl-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-lg font-semibold tracking-tight">
                  <a
                    href={e.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="decoration-[var(--color-border-strong)] decoration-1 underline-offset-4 hover:underline"
                  >
                    {e.school}
                  </a>
                </h3>
                <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-accent)]">
                  {e.kind}
                </span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">{e.degree}</p>
              <p class="mt-0.5 font-mono text-xs text-[var(--color-text-dim)]">{e.where}</p>
              {e.highlight && (
                <p class="mt-2 inline-block rounded border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-2 py-0.5 font-mono text-[11px] text-[var(--color-text)]">
                  {e.highlight}
                </p>
              )}
              <ul class="mt-3 space-y-1.5 text-sm text-[var(--color-text-muted)]">
                {e.notes.map((n) => (
                  <li class="relative pl-4 before:absolute before:left-0 before:text-[var(--color-accent-dim)] before:content-['›']">
                    {n}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16">
      <h2 class="mb-6 text-lg font-semibold tracking-tight">Achievements</h2>
      <div class="space-y-5">
        {
          achievements.map((a) => (
            <div class="border-l border-[var(--color-border)] pl-5 sm:pl-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-semibold tracking-tight">{a.title}</h3>
                <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-text-dim)]">
                  {a.when}
                </span>
              </div>
              <p class="mt-1 font-mono text-xs text-[var(--color-text-dim)]">{a.org}</p>
              {a.note && (
                <p class="mt-1.5 text-sm text-[var(--color-text-muted)]">{a.note}</p>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16">
      <h2 class="mb-6 text-lg font-semibold tracking-tight">Skills</h2>
      <dl class="space-y-6">
        {
          Object.entries(skills).map(([group, items]) => (
            <div class="grid gap-2 sm:grid-cols-[140px_1fr] sm:gap-6">
              <dt class="font-mono text-xs uppercase tracking-wider text-[var(--color-text-dim)]">
                {group}
              </dt>
              <dd>
                <ul class="flex flex-wrap gap-1.5">
                  {items.map((item) => (
                    <li class="rounded border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-2 py-0.5 font-mono text-[11px] text-[var(--color-text-muted)]">
                      {item}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-16 border-t border-[var(--color-border)] pt-10">
      <h2 class="mb-4 text-lg font-semibold tracking-tight">Reach me</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href={SITE.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-accent)] hover:underline underline-offset-4"
            >Book a 15-min call ↗</a
          >
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-[var(--color-accent)]"
            >Email</a
          >
        </li>
        <li>
          <a
            href={SITE.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">LinkedIn ↗</a
          >
        </li>
        <li>
          <a
            href={SITE.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">GitHub ↗</a
          >
        </li>
        <li>
          <a
            href={SITE.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)]">Résumé (PDF) ↗</a
          >
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
