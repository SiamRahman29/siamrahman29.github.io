---
import { SITE } from '~/config';
---

<section
  class="hero container-wide flex min-h-[calc(100svh-77px)] flex-col justify-center py-12 sm:py-16"
>
  <div class="anim-fade-in-up flex items-center gap-2 text-xs text-[var(--color-text-muted)]">
    <span class="relative inline-flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-60"
      ></span>
      <span
        class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"
      ></span>
    </span>
    <span class="font-mono uppercase tracking-wider">Scio me nihil scire</span>
  </div>

  <h1
    class="hero-title anim-fade-in-up mt-6 text-balance text-4xl font-semibold leading-tight tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl"
    style="animation-delay: 80ms"
  >
    Hi, I'm <span class="text-[var(--color-accent)]">Siam</span>.<br />
    I build AI and web applications.
  </h1>

  <p
    class="hero-lead anim-fade-in-up mt-6 max-w-2xl text-pretty text-base leading-relaxed text-[var(--color-text-muted)] sm:text-lg"
    style="animation-delay: 160ms"
  >
    Ex-<a
      href="https://grab.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-text)] underline decoration-[var(--color-border-strong)] underline-offset-4 hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)]"
      >Grab</a
    >, Ex-<a
      href="https://app.askturing.ai"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-text)] underline decoration-[var(--color-border-strong)] underline-offset-4 hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)]"
      >AskTuring AI</a
    ><br />
    Founder of <a
      href="https://siamrahman29.github.io/K22B/"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-text)] underline decoration-[var(--color-border-strong)] underline-offset-4 hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)]"
      >K22B</a
    >, a fast-shipping web-dev garage<br />
    RAG, API endpoints, observability → jack of many trades<br />
    MNC-grade engineering rigour, early-stage startup velocity<br />
    
    Likes eating biriyani and reading books
  </p>

  <p
    class="hero-stack anim-fade-in-up mt-5 max-w-2xl font-mono text-xs text-[var(--color-text-dim)] sm:text-sm"
    style="animation-delay: 240ms"
  >
    Python · Go · LangChain · LGTM · Dramatiq · Kubernetes · Azure · AWS
  </p>

  <div
    class="hero-actions anim-fade-in-up mt-10 flex flex-wrap items-center gap-3 text-sm"
    style="animation-delay: 320ms"
  >
    <a
      href={SITE.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md border border-[var(--color-accent)] bg-[var(--color-accent)] px-4 py-2 font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 hover:text-[var(--color-bg)]"
    >
      Book a 15-min call →
    </a>
    <a
      href={`mailto:${SITE.email}`}
      class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
    >
      Email
    </a>
    <a
      href={SITE.resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
    >
      Résumé (PDF)
    </a>
    <a
      href={SITE.socials.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="rounded-md border border-[var(--color-border-strong)] p-2 text-white transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
    </a>
    <a
      href={SITE.socials.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="rounded-md border border-[var(--color-border-strong)] p-2 text-white transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* Width breakpoints size the hero for a full desktop monitor, but a
     wide-but-short laptop still gets the biggest type with no vertical
     room. Scale type and spacing down by viewport HEIGHT so the buttons
     always stay above the fold. */
  @media (max-height: 860px) {
    .hero {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }
    .hero-title {
      font-size: 2.5rem; /* ~text-4xl */
      line-height: 1.2;
      margin-top: 1.5rem;
    }
    .hero-lead {
      font-size: 1rem; /* text-base */
      line-height: 1.7;
      margin-top: 1.5rem;
    }
    .hero-stack {
      margin-top: 1.25rem;
    }
    .hero-actions {
      margin-top: 2rem;
    }
  }

  @media (max-height: 700px) {
    .hero-title {
      font-size: 2rem; /* text-3xl */
      line-height: 1.2;
      margin-top: 1.25rem;
    }
    .hero-lead {
      font-size: 0.9375rem;
      line-height: 1.6;
      margin-top: 1.25rem;
    }
    .hero-stack {
      margin-top: 1rem;
    }
    .hero-actions {
      margin-top: 1.5rem;
    }
  }
</style>
