---
interface Props {
  number: string;
  title: string;
  href?: string;
  hrefLabel?: string;
}
const { number, title, href, hrefLabel } = Astro.props;
---

<div class="mb-8 flex items-end justify-between border-b border-[var(--color-border)] pb-4">
  <h2 class="flex items-baseline gap-3 text-lg font-semibold tracking-tight text-[var(--color-text)]">
    <span class="font-mono text-xs text-[var(--color-accent)]">{number}</span>
    <span>{title}</span>
  </h2>
  {
    href && hrefLabel && (
      <a
        href={href}
        class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)]"
      >
        {hrefLabel} →
      </a>
    )
  }
</div>
