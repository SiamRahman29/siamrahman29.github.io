---
/** Soft green radial glow that follows the cursor (Brittany Chiang–style spotlight). */
---

<div class="cursor-spotlight" aria-hidden="true"></div>

<style>
  .cursor-spotlight {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      720px circle at var(--spotlight-x, 0px) var(--spotlight-y, 0px),
      rgba(74, 222, 128, 0.14),
      rgba(34, 197, 94, 0.07) 18%,
      rgba(22, 163, 74, 0.03) 32%,
      transparent 55%
    );
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .cursor-spotlight {
      display: none;
    }
  }
</style>

<script>
  const canSpotlight = window.matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  ).matches;

  if (canSpotlight) {
    const root = document.documentElement;
    root.style.setProperty('--spotlight-x', '0px');
    root.style.setProperty('--spotlight-y', '0px');

    window.addEventListener(
      'mousemove',
      (e) => {
        root.style.setProperty('--spotlight-x', `${e.clientX}px`);
        root.style.setProperty('--spotlight-y', `${e.clientY}px`);
      },
      { passive: true },
    );
  }
</script>
