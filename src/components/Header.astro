---
import { NAV, SITE } from '~/config';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  if (href.startsWith('/#')) return false;
  return path === href || path.startsWith(href + '/');
};
---

<header class="border-b border-[var(--color-border)]">
  <div class="container-wide flex items-center justify-between py-5">
    <a
      href="/"
      class="font-mono text-sm tracking-tight text-[var(--color-text)] hover:text-[var(--color-accent)]"
      aria-label={`${SITE.author} — home`}
    >
      <span class="text-[var(--color-accent)]">$</span> siam
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'inline-block rounded px-3 py-2 transition-colors',
                  isActive(item.href)
                    ? 'text-[var(--color-accent)]'
                    : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
