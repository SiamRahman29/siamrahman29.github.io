---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, tech, period, role } = project.data;
const href = `/projects/${project.data.slug}`;
---

<a
  href={href}
  class="group relative flex h-full flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-text)]"
>
  <div class="flex items-start justify-between gap-3">
    <h3
      class="text-base font-medium text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)]"
    >
      {title}
    </h3>
    <span
      class="select-none text-[var(--color-text-dim)] transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--color-accent)]"
      aria-hidden="true">↗</span
    >
  </div>

  <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-[var(--color-text-dim)]">
    {role} · {period}
  </p>

  <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
    {summary}
  </p>

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      tech.slice(0, 6).map((t) => (
        <li class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--color-text-muted)]">
          {t}
        </li>
      ))
    }
  </ul>
</a>
